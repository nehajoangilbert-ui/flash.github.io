# Copy this file to ".env" (no .example). Leave values blank for DEV mode:
# in DEV mode OTPs and keys are PRINTED in the black terminal window instead of being sent.
PORT=3000

# --- Real SMS (Twilio) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=+10000000000

# --- Real email (Gmail example). Needs:  npm install nodemailer ---
# Gmail: turn on 2-step verification, then create an "App password" and paste it below.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=
MAIL_FROM="FLASH Security <youraddress@gmail.com>"
